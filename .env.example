# Copy to .env — consumed by docker compose (never committed).
POSTGRES_USER="example_user"
POSTGRES_PASSWORD="example_password"
POSTGRES_DB="example_db_name"

# Host port the backend container is published on.
BACKEND_PORT=3000

# NOTE: the backend container's DATABASE_URL is derived from the values above in
# docker-compose.yml. For running the app on the host, see backend/.env.example.
