model Idea {
    id String @id @default(cuid(2))
    title String
    url String?
    note String?
    updatedAt DateTime @updatedAt
    authorId String
    author User @relation(fields: [authorId], references: [id])
    householdId String
    household Household @relation(fields: [householdId], references: [id])
    labels Label[]
}